import React, { useState } from 'react';
import { 
  Building2, 
  PlusCircle, 
  ShieldCheck, 
  TrendingUp, 
  CheckCircle2, 
  Star, 
  AlertCircle, 
  Search, 
  Clock,
  ArrowRight,
  FileCheck,
  Building
} from 'lucide-react';
import confetti from 'canvas-confetti';
import { BuyerProfile, BuyerOffer, CropType, QualityGrade, Language, ProduceLot } from '../types';
import { translations } from '../utils/translations';
import { MOCK_BUYERS, MOCK_BUYER_OFFERS, CROP_CONFIGS } from '../data/mockData';

interface BuyerDashboardProps {
  language: Language;
  activeLot?: ProduceLot;
  onInitiateBidOnLot?: (lot: ProduceLot, pricePerQtl: number) => void;
  onInitiateNegotiation?: (lot: ProduceLot, buyerId: string, buyerName: string, offeredPrice: number, quantity: number) => void;
  onMakeCounterOffer?: (negId: string, price: number, message: string) => void;
  onAcceptOffer?: (negId: string) => void;
  onRejectOffer?: (negId: string) => void;
}

export const BuyerDashboard: React.FC<BuyerDashboardProps> = ({
  language,
  activeLot,
  onInitiateBidOnLot,
}) => {
  const t = translations[language];

  const [currentBuyer, setCurrentBuyer] = useState<BuyerProfile>(MOCK_BUYERS[0]);
  const [buyerOffers, setBuyerOffers] = useState<BuyerOffer[]>(MOCK_BUYER_OFFERS);
  const [showNewOfferModal, setShowNewOfferModal] = useState<boolean>(false);
  const [currentNegotiation, setCurrentNegotiation] = useState<{ lotId: string; offerId: string } | null>(null);
  const [showCounterOfferModal, setShowCounterOfferModal] = useState<boolean>(false);
  const [counterOfferPrice, setCounterOfferPrice] = useState<number>(0);
  const [counterOfferMessage, setCounterOfferMessage] = useState<string>('');

  // New Offer Form State
  const [newCrop, setNewCrop] = useState<CropType>('Wheat');
  const [newPrice, setNewPrice] = useState<number>(2480);
  const [newMinQty, setNewMinQty] = useState<number>(20);
  const [newMaxQty, setNewMaxQty] = useState<number>(250);
  const [newGrade, setNewGrade] = useState<QualityGrade>('Grade A (Premium)');
  const [newPaymentTerms, setNewPaymentTerms] = useState<BuyerOffer['paymentTerms']>('Next Day (T+1)');

  const handleCreateOffer = (e: React.FormEvent) => {
    e.preventDefault();
    const negotiationId = `neg-${Date.now()}`;
    const created: BuyerOffer = {
      id: `offer-${Date.now()}`,
      buyerId: currentBuyer.id,
      buyerName: currentBuyer.companyName,
      buyerCategory: currentBuyer.category,
      buyerLocation: `${currentBuyer.district} Processing Hub`,
      distanceKm: 22,
      crop: newCrop,
      minQuantityQtl: Number(newMinQty),
      maxQuantityQtl: Number(newMaxQty),
      offeredPricePerQtl: Number(newPrice),
      requiredGrade: newGrade,
      paymentTerms: newPaymentTerms,
      reliabilityScore: currentBuyer.reliabilityScore,
      offerValidUntil: '2026-08-30',
      negotiationId,
      counterOfferHistory: [],
    };

    setBuyerOffers([created, ...buyerOffers]);
    setShowNewOfferModal(false);
    confetti({
      particleCount: 50,
      spread: 60,
      origin: { y: 0.6 },
    });
  };

  const handleCounterOffer = (e: React.FormEvent, originalOfferId: string) => {
    e.preventDefault();
    const existingOffer = buyerOffers.find(o => o.id === originalOfferId);
    if (!existingOffer) return;

    const newCounterOffer: BuyerOffer = {
      ...existingOffer,
      offeredPricePerQtl: counterOfferPrice,
      counterOfferHistory: [
        ...(existingOffer.counterOfferHistory || []),
        {
          id: `counter-${Date.now()}`,
          offerId: originalOfferId,
          pricePerQtl: counterOfferPrice,
          quantityQtl: existingOffer.minQuantityQtl,
          message: counterOfferMessage,
          sender: 'buyer',
          timestamp: new Date().toISOString(),
          status: 'pending',
        },
      ],
      negotiationId: existingOffer.negotiationId,
    };

    setBuyerOffers(
      buyerOffers.map((offer) =>
        offer.id === originalOfferId ? newCounterOffer : offer
      )
    );
    setShowCounterOfferModal(false);
    setCurrentNegotiation(null);
    setCounterOfferPrice(0);
    setCounterOfferMessage('');
  };

  return (
    <div className="max-w-6xl mx-auto px-4 py-6 space-y-8">
      {/* Buyer Profile & Trust Header */}
      <div className="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-800 space-y-6">
        <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div className="flex items-center gap-4">
            <div className="w-16 h-16 rounded-2xl bg-blue-600/30 border border-blue-400/40 text-blue-400 flex items-center justify-center font-bold text-2xl">
              <Building2 className="w-8 h-8" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h2 className="text-2xl font-extrabold text-white">{currentBuyer.companyName}</h2>
                <span className="bg-blue-500/20 text-blue-300 text-xs font-semibold px-2 py-0.5 rounded-full border border-blue-500/30">
                  {currentBuyer.category}
                </span>
                {currentBuyer.verified && (
                  <span className="bg-emerald-500/20 text-emerald-300 text-xs font-bold px-2 py-0.5 rounded-full border border-emerald-500/40 flex items-center gap-1">
                    <ShieldCheck className="w-3.5 h-3.5" />
                    Verified
                  </span>
                )}
              </div>
              <p className="text-xs text-slate-400 mt-1">
                {currentBuyer.location} • {currentBuyer.contactPerson} ({currentBuyer.phone})
              </p>
            </div>
          </div>

          <button
            onClick={() => setShowNewOfferModal(true)}
            className="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-blue-600/30 transition-all flex items-center gap-2"
          >
            <PlusCircle className="w-4 h-4" />
            <span>{t.postDemand}</span>
          </button>
        </div>

        {/* Buyer Reliability Scorecard (PRD Section 11 Requirement) */}
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-4 border-t border-slate-800 text-xs">
          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Reliability Index</div>
            <div className="text-xl font-black text-emerald-400 mt-1">{currentBuyer.reliabilityScore}%</div>
            <div className="text-[10px] text-emerald-300">Top Tier Buyer</div>
          </div>

          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Completed Trades</div>
            <div className="text-xl font-black text-white mt-1">{currentBuyer.metrics.completedTransactions}</div>
            <div className="text-[10px] text-slate-400">₹3.8 Cr Total Volume</div>
          </div>

          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Avg Payment Settlement</div>
            <div className="text-xl font-black text-blue-400 mt-1">{currentBuyer.metrics.avgPaymentDelayDays} days</div>
            <div className="text-[10px] text-blue-300">T+1 Guaranteed</div>
          </div>

          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Fulfillment Rate</div>
            <div className="text-xl font-black text-white mt-1">{currentBuyer.metrics.fulfillmentHistoryPercent}%</div>
            <div className="text-[10px] text-slate-400">Zero default</div>
          </div>

          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Dispute / Reject Rate</div>
            <div className="text-xl font-black text-emerald-400 mt-1">{currentBuyer.metrics.disputeRatePercent}%</div>
            <div className="text-[10px] text-slate-400">Standard Lab testing</div>
          </div>

          <div className="bg-slate-800/80 p-3 rounded-xl border border-slate-700">
            <div className="text-slate-400 text-[11px]">Farmer Satisfaction</div>
            <div className="text-xl font-black text-amber-400 mt-1 flex items-center gap-1">
              <span>{currentBuyer.metrics.farmerRating}</span>
              <Star className="w-4 h-4 fill-amber-400 text-amber-400" />
            </div>
            <div className="text-[10px] text-slate-400">320+ Farmer Ratings</div>
          </div>
        </div>
      </div>

      {/* Live Verified Farmer Lots & Pools Available for Bidding */}
      <div className="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-blue-700">
              {language === 'en' ? 'Supply Discovery' : 'उपलब्ध किसान आपूर्ति'}
            </span>
            <h3 className="text-xl font-bold text-slate-900 mt-1">
              {t.buyerLotsTitle}
            </h3>
          </div>

          <div className="flex items-center gap-2">
            <span className="text-xs font-semibold text-slate-500">
              {language === 'en' ? 'Direct Farmgate Quality Verified' : 'गुणवत्ता सत्यापित लॉट'}
            </span>
          </div>
        </div>

        {/* Lots Grid */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {activeLot && (
            <div className="rounded-2xl p-5 border-2 border-blue-500 bg-blue-50/40 shadow-xs space-y-4">
              <div className="flex items-center justify-between">
                <span className="text-xs font-extrabold text-blue-800 bg-blue-100 px-2.5 py-0.5 rounded-full">
                  ★ Active User Lot
                </span>
                <span className="text-xs font-bold text-slate-600">
                  {activeLot.district}
                </span>
              </div>

              <div>
                <h4 className="font-bold text-base text-slate-900">
                  {activeLot.crop} ({activeLot.quantityQuintals} qtl / {(activeLot.quantityQuintals / 10).toFixed(1)}T)
                </h4>
                <p className="text-xs text-slate-600 mt-0.5">
                  {activeLot.grade} • Moisture {activeLot.moisturePercent}% • {activeLot.farmerName}
                </p>
              </div>

              <div className="bg-white p-3 rounded-xl border border-blue-200 text-xs space-y-1">
                <div className="flex justify-between">
                  <span className="text-slate-500">Target Realization:</span>
                  <span className="font-bold text-emerald-700">~₹{CROP_CONFIGS[activeLot.crop]?.avgModalPrice || 2450}/qtl</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-slate-500">Harvest Date:</span>
                  <span className="font-semibold text-slate-800">{activeLot.harvestDate}</span>
                </div>
              </div>

              <button
                onClick={() => onInitiateBidOnLot && onInitiateBidOnLot(activeLot, 2480)}
                className="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5"
              >
                <span>Place Spot Procurement Bid</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </button>
            </div>
          )}

          {/* Sample Additional Lots */}
          <div className="rounded-2xl p-5 border border-slate-200 bg-white hover:border-slate-300 shadow-xs space-y-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-extrabold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">
                🌾 Aggregated Pool (4 Farmers)
              </span>
              <span className="text-xs font-bold text-slate-600">Neemrana, Alwar</span>
            </div>

            <div>
              <h4 className="font-bold text-base text-slate-900">
                Wheat Lot (10.0 Tonnes / 100 Qtl)
              </h4>
              <p className="text-xs text-slate-600 mt-0.5">
                Grade A (Premium) • Moisture 11.8% • FPO Cluster
              </p>
            </div>

            <div className="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs space-y-1">
              <div className="flex justify-between">
                <span className="text-slate-500">Bulk Target:</span>
                <span className="font-bold text-slate-900">₹2,560 /qtl</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Logistics Ready:</span>
                <span className="font-semibold text-emerald-700">16T Truck Ready</span>
              </div>
            </div>

            <button
              onClick={() => alert("Direct tender bid sent to FPO Cluster coordinator.")}
              className="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs transition-colors"
            >
              Submit Institutional Bid
            </button>
          </div>

          <div className="rounded-2xl p-5 border border-slate-200 bg-white hover:border-slate-300 shadow-xs space-y-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-extrabold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">
                🌻 Mustard Oilseed Lot
              </span>
              <span className="text-xs font-bold text-slate-600">Bharatpur</span>
            </div>

            <div>
              <h4 className="font-bold text-base text-slate-900">
                Mustard Lot (11.4 Tonnes / 114 Qtl)
              </h4>
              <p className="text-xs text-slate-600 mt-0.5">
                Grade A • Oil Content 41.5% • Ready for Dispatch
              </p>
            </div>

            <div className="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs space-y-1">
              <div className="flex justify-between">
                <span className="text-slate-500">Reserve Price:</span>
                <span className="font-bold text-slate-900">₹6,180 /qtl</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-500">Lab Tested:</span>
                <span className="font-semibold text-emerald-700">NABL Certified</span>
              </div>
            </div>

            <button
              onClick={() => alert("Direct tender bid placed with Bharatpur Oilseed cluster.")}
              className="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs transition-colors"
            >
              Submit Institutional Bid
            </button>
          </div>
        </div>
      </div>

      {/* Negotiation Panel (PRD Sections 7 & 8) */}
      {activeLot && (
        <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 className="font-bold text-base text-slate-900">
              {language === 'en' ? 'Make an Offer' : 'ऑफर लगाएं'}
            </h3>
            <span className="text-xs text-emerald-700 font-semibold">Track negotiations</span>
          </div>
          <p className="text-slate-500 text-sm">
              {language === 'en' ? (
                `Submit an offer for ${activeLot.crop} (${activeLot.quantityQuintals} qtl) at ₹${newPrice}/qtl. The farmer can counter-offer, and you can respond. All offers are preserved in the negotiation history.`
              ) : (
                `खरीदार ${activeLot.crop} के लिए ऑफर लगाएं (${activeLot.quantityQuintals} qtl) ₹${newPrice}/qtl पर। किसान counter-offer कर सकता है, और आप जवाब दे सकते हैं। सभी ऑफर बातचीत इतिहास में संरक्षित हैं।`
              )}
            </p>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
            <div>
              <label className="block font-bold text-slate-700 text-xs mb-1">Offer Price (₹/qtl)</label>
              <input
                type="number"
                ref={offerPriceRef}
                value={newPrice}
                onChange={(e) => setNewPrice(Number(e.target.value))}
                className="w-full p-2 rounded border border-slate-300 font-medium text-slate-900"
                min={1000}
                max={10000}
                required
              />
            </div>
            <div>
              <label className="block font-bold text-slate-700 text-xs mb-1">Quantity (Qtl)</label>
              <input
                type="number"
                ref={quantityRef}
                value={Math.min(activeLot.quantityQuintals, 200)}
                onChange={(e) => setNewPrice(Number(e.target.value))}
                className="w-full p-2 rounded border border-slate-300 font-medium text-slate-900"
                min={10}
                max={activeLot.quantityQuintals}
                required
              />
            </div>
          </div>
          <button
            onClick={() => onInitiateNegotiation?.(activeLot, currentBuyer.id, currentBuyer.companyName, newPrice, Math.min(200, activeLot.quantityQuintals))}
            className="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-colors flex items-center justify-center gap-2"
            disabled={!offerPriceRef.current || newPrice <= 0}
          >
            <MessageSquare className="w-4 h-4" />
            {language === 'en' ? 'Submit Offer to Farmer' : 'किसान को ऑफर दें'}
          </button>
          <div className="mt-4 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <p className="text-slate-600 text-xs">Your active offers will appear here</p>
            <div className="h-40 overflow-y-auto text-xs">
              {buyerOffers
                .filter((o) => o.negotiationId)
                .map((offer) => (
                  <div
                    key={offer.id}
                    className="p-2 border-b border-slate-100 last:border-0"
                  >
                    <div className="flex items-center justify-between mb-1">
                      <span className="font-bold text-slate-900">{offer.buyerName}</span>
                      <span className="text-xs text-slate-500">{offer.offeredPricePerQtl}/qtl</span>
                    </div>
                    <p className="text-[10px] text-slate-500">
                      {offer.minQuantityQtl}-{offer.maxQuantityQtl} qtl • {offer.paymentTerms}
                    </p>
                  </div>
                ))}
            </div>
          </div>
        </div>
      )}

      {/* New Offer Modal */}
      {showNewOfferModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-6">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <span className="text-xs font-bold text-blue-600 uppercase">Procurement Request</span>
                <h3 className="text-xl font-extrabold text-slate-900 mt-0.5">Post New Buyer Offer</h3>
              </div>
              <button
                onClick={() => setShowNewOfferModal(false)}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold"
              >
                ✕
              </button>
            </div>

            <form onSubmit={handleCreateOffer} className="space-y-4 text-xs">
              <div>
                <label className="block font-bold text-slate-700 mb-1">Select Crop</label>
                <select
                  value={newCrop}
                  onChange={(e) => {
                    const c = e.target.value as CropType;
                    setNewCrop(c);
                    setNewPrice(CROP_CONFIGS[c]?.avgModalPrice || 2500);
                  }}
                  className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                >
                  {Object.keys(CROP_CONFIGS).map((c) => (
                    <option key={c} value={c}>{c}</option>
                  ))}
                </select>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">Offered Price (₹/qtl)</label>
                  <input
                    type="number"
                    value={newPrice}
                    onChange={(e) => setNewPrice(Number(e.target.value))}
                    className="w-full p-2.5 rounded-xl border border-slate-300 font-bold text-slate-900"
                    required
                  />
                </div>

                <div>
                  <label className="block font-bold text-slate-700 mb-1">Quality Requirement</label>
                  <select
                    value={newGrade}
                    onChange={(e) => setNewGrade(e.target.value as QualityGrade)}
                    className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                  >
                    <option value="Grade A (Premium)">Grade A (Premium)</option>
                    <option value="Grade B (Fair/Avg)">Grade B (Fair/Avg)</option>
                    <option value="Grade C (Standard)">Grade C (Standard)</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">Min Quantity (Qtl)</label>
                  <input
                    type="number"
                    value={newMinQty}
                    onChange={(e) => setNewMinQty(Number(e.target.value))}
                    className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                    required
                  />
                </div>

                <div>
                  <label className="block font-bold text-slate-700 mb-1">Max Lot Size (Qtl)</label>
                  <input
                    type="number"
                    value={newMaxQty}
                    onChange={(e) => setNewMaxQty(Number(e.target.value))}
                    className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                    required
                  />
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">Payment Settlement Terms</label>
                <select
                  value={newPaymentTerms}
                  onChange={(e) => setNewPaymentTerms(e.target.value as BuyerOffer['paymentTerms'])}
                  className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                >
                  <option value="Immediate (T+0)">Immediate Direct Bank Transfer (T+0)</option>
                  <option value="Next Day (T+1)">Next Day Settlement (T+1)</option>
                  <option value="3 Days (T+3)">3 Days (T+3)</option>
                  <option value="Escrow Secured">Escrow Secured Fasalniti Account</option>
                </select>
              </div>

              <div className="pt-3 flex gap-2">
                <button
                  type="submit"
                  className="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md"
                >
                  Publish Procurement Offer
                </button>
                <button
                  type="button"
                  onClick={() => setShowNewOfferModal(false)}
                  className="px-4 py-3 rounded-xl bg-slate-100 text-slate-700 font-semibold text-sm"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Counter Offer Modal */}
      {currentNegotiation && showCounterOfferModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-6">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <span className="text-xs font-bold text-emerald-600 uppercase">Counter Offer</span>
                <h3 className="text-xl font-extrabold text-slate-900 mt-0.5">Respond to Farmer's Counter</h3>
              </div>
              <button
                onClick={() => {
                  setShowCounterOfferModal(false);
                  setCurrentNegotiation(null);
                }}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold"
              >
                ✕
              </button>
            </div>

            <form onSubmit={(e) => handleCounterOffer(e, currentNegotiation.offerId)} className="space-y-4 text-xs">
              <div>
                <label className="block font-bold text-slate-700 mb-1">Your Counter Price (₹/qtl)</label>
                <input
                  type="number"
                  value={counterOfferPrice}
                  onChange={(e) => setCounterOfferPrice(Number(e.target.value))}
                  className="w-full p-2.5 rounded-xl border border-slate-300 font-bold text-slate-900"
                  required
                />
                <p className="text-xs text-slate-500 mt-1">Current accepted price: ₹{buyerOffers.find(o => o.id === currentNegotiation.offerId)?.offeredPricePerQtl || 0}/qtl</p>
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">Message to Farmer (Optional)</label>
                <textarea
                  rows={3}
                  value={counterOfferMessage}
                  onChange={(e) => setCounterOfferMessage(e.target.value)}
                  className="w-full p-2.5 rounded-xl border border-slate-300 font-medium text-slate-900"
                />
              </div>

              <div className="pt-3 flex gap-2">
                <button
                  type="submit"
                  className="flex-1 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md"
                >
                  Submit Counter Offer
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setShowCounterOfferModal(false);
                    setCurrentNegotiation(null);
                  }}
                  className="px-4 py-3 rounded-xl bg-slate-100 text-slate-700 font-semibold text-sm"
                >
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};