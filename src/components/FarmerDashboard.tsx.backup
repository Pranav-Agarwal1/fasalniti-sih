              <span className="font-bold text-slate-900">{currentLot.quantityQuintals} qtl ({(currentLot.quantityQuintals / 10).toFixed(1)}T)</span>
            </div>
            <div className="flex justify-between py-1 border-b border-slate-50">
              <span className="text-slate-500">Grade & Moisture:</span>
              <span className="font-bold text-slate-900">{currentLot.grade} ({currentLot.moisturePercent}%)</span>
            </div>
            <div className="flex justify-between py-1 border-b border-slate-50">
              <span className="text-slate-500">Harvest Date:</span>
              <span className="font-semibold text-slate-800">{currentLot.harvestDate}</span>
            </div>
            <div className="flex justify-between py-1 border-b border-slate-50">
              <span className="text-slate-500">Storage Access:</span>
              <span className="font-semibold text-purple-700">{currentLot.storageAvailable ? 'WDRA Silo (12 km)' : 'None'}</span>
            </div>
          </div>

          <button
            onClick={onAddNewProduce}
            className="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors"
          >
            {language === 'en' ? 'Modify Lot Details' : 'विवरण बदलें'}
          </button>
        </div>

        {/* Right: Quick Selling Options Cards (PRD Section 10) */}
        <div className="lg:col-span-8 bg-white rounded-3xl p-6 border border-slate-200 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 className="font-bold text-base text-slate-900">
              {language === 'en' ? 'Selling Options Breakdown' : 'उपलब्ध 4 विक्रय माध्यम'}
            </h3>
            <span className="text-xs text-slate-500">
              {language === 'en' ? 'Ranked by take-home money' : 'शुद्ध बैंक प्राप्ति अनुसार'}
            </span>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {recommendation.allOptions.map((opt) => (
              <div
                key={opt.optionId}
                onClick={() => onViewOption(opt.optionId)}
                className="p-4 rounded-2xl border border-slate-200 hover:border-emerald-500 bg-slate-50/50 hover:bg-emerald-50/20 transition-all cursor-pointer space-y-2 group"
              >
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-extrabold uppercase bg-slate-200 group-hover:bg-emerald-200 text-slate-800 px-2 py-0.5 rounded">
                    {opt.optionType}
                  </span>
                  <span className="text-xs font-bold text-emerald-700">
                    Score: {opt.recommendationScore}
                  </span>
                </div>

                <div className="font-bold text-sm text-slate-900 group-hover:text-emerald-900 truncate">
                  {opt.title}
                </div>

                <div className="flex items-baseline justify-between pt-1">
                  <div>
                    <div className="text-[10px] text-slate-400">Net in Bank:</div>
                    <div className="text-lg font-black text-slate-900">
                      ₹{opt.netRealization.toLocaleString('en-IN')}
                    </div>
                  </div>
                  <div className="text-xs font-bold text-slate-500">
                    ₹{opt.netRealizationPerQtl}/qtl
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Market Snapshot & Transactions */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Market Snapshot (PRD Section 10) */}
        <div className="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 className="font-bold text-base text-slate-900">
              {language === 'en' ? 'Live Market Snapshot' : 'आज का मंडी भाव'}
            </h3>
            <span className="text-xs text-emerald-700 font-semibold">Live Feed</span>
          </div>

          <div className="space-y-3">
            {MOCK_MANDIS.slice(0, 3).map((mandi) => (
              <div key={mandi.id} className="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between text-xs">
                <div>
                  <div className="font-bold text-slate-900">{mandi.mandiName}</div>
                  <div className="text-slate-500">{mandi.crop} • {mandi.distanceKm} km away</div>
                </div>
                <div className="text-right">
                  <div className="font-black text-sm text-slate-900">₹{mandi.modalPricePerQtl} <span className="text-[10px] font-normal text-slate-500">/qtl</span></div>
                  <div className={`text-[10px] font-bold flex items-center justify-end gap-0.5 ${
                    mandi.trend === 'up' ? 'text-emerald-700' : mandi.trend === 'down' ? 'text-rose-600' : 'text-slate-500'
                  }`}>
                    {mandi.trend === 'up' ? <TrendingUp className="w-3 h-3" /> : <TrendingDown className="w-3 h-3" />}
                    <span>{mandi.trend === 'up' ? '+₹40 today' : 'Stable'}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* My Transactions (PRD Section 10) */}
        <div className="lg:col-span-7 bg-white rounded-3xl p-6 border border-slate-200 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 className="font-bold text-base text-slate-900">
              {language === 'en' ? 'My Transactions' : 'मेरे पिछले सौदे एवं भुगतान'}
            </h3>
            <span className="text-xs font-semibold text-slate-500">
              {transactions.length} Records
            </span>
          </div>

          <div className="space-y-3">
            {transactions.map((txn) => (
              <div
                key={txn.id}
                onClick={() => onViewTransaction(txn)}
                className="p-3.5 bg-slate-50 hover:bg-slate-100/80 rounded-2xl border border-slate-200 flex items-center justify-between text-xs transition-colors cursor-pointer"
              >
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <span className="font-bold text-slate-900">{txn.crop} ({txn.quantityQtl} qtl)</span>
                    <span className="text-[10px] font-mono bg-slate-200 text-slate-700 px-1.5 py-0.5 rounded">
                      {txn.id}
                    </span>
                  </div>
                  <div className="text-slate-500">
                    {txn.buyerOrEntityName} • {txn.date}
                  </div>
                </div>

                <div className="text-right space-y-1">
                  <div className="font-black text-sm text-emerald-700">
                    ₹{txn.netPayableToFarmer.toLocaleString('en-IN')}
                  </div>
                  <span className={`inline-block text-[10px] font-bold px-2 py-0.5 rounded-full ${
                    txn.status === 'completed'
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-amber-100 text-amber-800'
                  }`}>
                    {txn.paymentStatus}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};
