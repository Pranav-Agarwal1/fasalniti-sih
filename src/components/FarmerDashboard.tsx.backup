          <div className="space-y-3 text-xs">
            <div className="flex justify-between py-1 border-b border-slate-50">
              <span className="text-slate-500">Crop:</span>
              <span className="font-bold text-slate-900">{currentLot.crop}</span>
            </div>
            <div className="flex justify-between py-1 border-b border-slate-50">
