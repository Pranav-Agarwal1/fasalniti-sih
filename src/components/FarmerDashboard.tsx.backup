import React, { useEffect } from 'react';
import { 
  Sparkles, 
  ArrowRight, 
  TrendingUp, 
  TrendingDown, 
  Clock, 
  CheckCircle2, 
  Building, 
  Users, 
  Warehouse, 
  PlusCircle, 
  ShieldCheck, 
  FileText,
  MapPin,
  Coins,
  MessageCircle,
  MessageSquare
} from 'lucide-react';
import { ProduceLot, RecommendationResult, TransactionRecord, Language, SellingOptionBreakdown } from '../types';
import { translations } from '../utils/translations';
import { MOCK_MANDIS, MOCK_BUYER_OFFERS, MOCK_TRANSACTIONS } from '../data/mockData';

interface FarmerDashboardProps {
  language: Language;
  currentLot: ProduceLot;
  recommendation: RecommendationResult;
  transactions?: TransactionRecord[];
  onAddNewProduce: () => void;
  onViewRecommendation: () => void;
  onViewOption: (optId: string) => void;
  onViewTransaction: (txn: TransactionRecord) => void;
  onInitiateNegotiation?: (lot: ProduceLot, buyerId: string, buyerName: string) => void;
  onNegotiationUpdate?: (negId: string) => void;
}

export const FarmerDashboard: React.FC<FarmerDashboardProps> = ({
  language,
  currentLot,
  recommendation,
  transactions = MOCK_TRANSACTIONS,
  onAddNewProduce,
  onViewRecommendation,
  onViewOption,
  onViewTransaction,
  onInitiateNegotiation,
}) => {
  const t = translations[language];
  const winner = recommendation.recommendedOption;

  return (
    <div className="max-w-6xl mx-auto px-4 py-6 space-y-8">
      {/* Top Welcome Bar */}
      <div className="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <div className="flex items-center gap-2">
            <span className="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded">
              {language === 'en' ? 'Farmer Decision Hub' : 'किसान निर्णय डैशबोर्ड'}
            </span>
            <span className="text-xs text-slate-500">{currentLot.district}, {currentLot.state}</span>
          </div>
          <h2 className="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">
            {language === 'en' ? `Welcome, ${currentLot.farmerName}` : `नमस्ते, ${currentLot.farmerName}`}
          </h2>
          <p className="text-xs text-slate-600 mt-0.5">
            {language === 'en'
              ? 'Real-time Net Realization analytics and selling recommendations for your active harvests.'
              : 'आपकी फसलों के लिए वास्तविक शुद्ध कमाई विश्लेषण एवं दैनिक सिफारिशें।'}
          </p>
        </div>

        <button
          onClick={onAddNewProduce}
          className="px-5 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-600/25 transition-all flex items-center gap-2"
        >
          <PlusCircle className="w-4 h-4" />
          <span>{language === 'en' ? 'Add New Produce Lot' : 'नई फसल जोड़ें'}</span>
        </button>
      </div>

      {/* Today's Smart Recommendation Banner (PRD Section 10 Requirement) */}
      <div className="bg-gradient-to-br from-emerald-900 via-emerald-800 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border-2 border-emerald-400 relative overflow-hidden">
        <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div className="inline-flex items-center gap-2 bg-emerald-400 text-slate-950 font-black text-xs px-3.5 py-1 rounded-full uppercase">
            <Sparkles className="w-3.5 h-3.5" />
            <span>{t.recBadge}</span>
          </div>

          <span className="text-xs text-emerald-200">
            {language === 'en' ? 'Calculated Just Now' : 'ताज़ा गणना'}
          </span>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div className="lg:col-span-8 space-y-2">
            <h3 className="text-2xl sm:text-3xl font-extrabold text-white">
              {winner.title}
            </h3>
            <p className="text-xs sm:text-sm text-emerald-100 leading-relaxed max-w-xl">
              {language === 'hi' ? recommendation.recommendationExplanation.hi : recommendation.recommendationExplanation.en}
            </p>

            <div className="pt-3 flex flex-wrap items-center gap-3">
              <button
                onClick={onViewRecommendation}
                className="px-5 py-2.5 rounded-xl bg-white text-emerald-950 hover:bg-emerald-50 font-extrabold text-xs shadow-md transition-all flex items-center gap-1.5"
              >
                <span>{language === 'en' ? 'Review & Lock Deal' : 'सौदा देखें व पक्का करें'}</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </button>

              <span className="text-xs text-emerald-200 flex items-center gap-1">
                <ShieldCheck className="w-4 h-4 text-emerald-400" />
                <span>{winner.paymentTimeline}</span>
              </span>
            </div>
          </div>

          <div className="lg:col-span-4 bg-emerald-950/80 rounded-2xl p-5 border border-emerald-500/40 text-center space-y-1">
            <span className="text-[11px] uppercase font-bold text-emerald-300">
              {t.netRealizationHeader}
            </span>
            <div className="text-3xl font-black text-white">
              ₹{winner.netRealization.toLocaleString('en-IN')}
            </div>
            <div className="text-xs font-bold text-emerald-300">
              ₹{winner.netRealizationPerQtl} /qtl in your bank
            </div>
          </div>
        </div>
      </div>

      {/* Negotiation Panel (PRD Section 7 & 8) */}
      <div className="mt-6 bg-white rounded-3xl p-6 border border-slate-200 shadow-xs">
        <div className="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 className="font-bold text-base text-slate-900">
            {language === 'en' ? 'Negotiation Center' : 'बातचीत केंद्र'}
          </h3>
          <span className="text-xs text-emerald-700 font-semibold">Active: {recommendation.counterOffers?.length || 0}</span>
        </div>
        <p className="text-slate-500 text-sm mb-4">
          {language === 'en'
            ? 'Offers from buyers and counter-offers are tracked here. Accept the best deal to proceed toward transaction.'
            : 'खरीदारों से ऑफर और counter-offers यहाँ ट्रैक किए जाते हैं। सबसे अच्छी डील स्वीकार करके लेन-देन की ओर बढ़ें।'}
        </p>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
          <button
            onClick={() => onInitiateNegotiation?.(currentLot, 'buyer-abc', 'ABC Agro Foods Ltd')}
            className="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md transition-colors flex items-center justify-center gap-2"
          >
            <MessageCircle className="w-4 h-4" />
            {language === 'en' ? 'Receive Buyer Offer' : 'खरीदार से ऑफर प्राप्त करें'}
          </button>
          <button
            onClick={() => onInitiateNegotiation?.(currentLot, 'buyer-itc', 'ITC Choupal Agri Direct')}
            className="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs shadow-md transition-colors flex items-center justify-center gap-2"
          >
            <MessageCircle className="w-4 h-4" />
            {language === 'en' ? 'Receive ITC Offer' : 'ITC से ऑफर प्राप्त करें'}
          </button>
        </div>
        <div id="farmer-negotiation-history" className="h-64 overflow-y-auto border border-slate-200 rounded-sm p-3 bg-slate-50 text-xs">
          <p className="text-slate-500">Loading negotiation activity...</p>
        </div>
      </div>

      {/* Active Produce Lot Card & Selling Options */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left: Active Produce Overview */}
        <div className="lg:col-span-4 bg-white rounded-3xl p-6 border border-slate-200 shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 className="font-bold text-base text-slate-900">
