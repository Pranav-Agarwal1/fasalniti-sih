import React, { useState, useEffect } from 'react';
import { 
  CheckCircle2, 
  Sparkles, 
  ArrowRight, 
  ChevronDown, 
  ChevronUp, 
  Building, 
  TrendingUp, 
  Users, 
  Warehouse, 
  ShieldCheck, 
  Truck, 
  HelpCircle, 
  Coins, 
  AlertCircle, 
  FileText, 
  RotateCcw,
  BadgePercent,
  Check,
  MessageCircle,
  MessageSquare,
  Menu
} from 'lucide-react';
import confetti from 'canvas-confetti';
import { RecommendationResult, SellingOptionBreakdown, Language, ProduceLot, BuyerOffer, NegotiationRecord, CounterOfferRecord } from '../types';
import { fetchGovernmentMarketPrices } from '../services/marketDataService';
import { translations } from '../utils/translations';

interface RecommendationEngineViewProps {
  language: Language;
  recommendation: RecommendationResult;
  lot: ProduceLot;
  onAcceptOption: (option: SellingOptionBreakdown) => void;
  onOpenAiAdvisor: () => void;
  onOpenComparison: () => void;
  onEditLot: () => void;
  onInitiateNegotiation?: (lot: ProduceLot, buyerId: string, buyerName: string) => void;
  onMakeCounterOffer?: (negId: string, price: number, quantity: number, message: string) => void;
  onAcceptOffer?: (negId: string) => void;
  onRejectOffer?: (negId: string) => void;
}

export const RecommendationEngineView: React.FC<RecommendationEngineViewProps> = ({
  language,
  recommendation,
  lot,
  onAcceptOption,
  onOpenAiAdvisor,
  onOpenComparison,
  onEditLot,
  onInitiateNegotiation,
}) => {
  const t = translations[language];
  const [selectedBreakdownOption, setSelectedBreakdownOption] = useState<SellingOptionBreakdown>(recommendation.recommendedOption);
  const [showCostBreakdownModal, setShowCostBreakdownModal] = useState<boolean>(false);

  const winningOption = recommendation.recommendedOption;
  const isHindi = language === 'hi';

  const handleAcceptWinning = () => {
    confetti({
      particleCount: 80,
      spread: 70,
      origin: { y: 0.6 },
    });
    onAcceptOption(winningOption);
  };

  const getOptionIcon = (optId: string) => {
    switch (optId) {
      case 'buyer':
        return <Building className="w-5 h-5" />;
      case 'mandi':
        return <TrendingUp className="w-5 h-5" />;
      case 'aggregation':
        return <Users className="w-5 h-5" />;
      case 'storage':
        return <Warehouse className="w-5 h-5" />;
      default:
        return <Coins className="w-5 h-5" />;
    }
  };

  return (
    <div className="max-w-6xl mx-auto px-4 py-6 space-y-8">
      {/* Top Banner with Lot Summary */}
      <div className="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-black text-lg">
            🌾
          </div>
          <div>
            <div className="flex items-center gap-2">
              <span className="font-extrabold text-lg text-slate-900">{lot.crop}</span>
              <span className="text-xs bg-slate-100 text-slate-700 font-semibold px-2 py-0.5 rounded border border-slate-200">
                {lot.quantityQuintals} qtl ({(lot.quantityQuintals / 10).toFixed(1)} Tonnes)
              </span>
              <span className="text-xs bg-emerald-50 text-emerald-800 font-semibold px-2 py-0.5 rounded border border-emerald-200">
                {lot.grade}
              </span>
            </div>
            <div className="text-xs text-slate-500 mt-0.5">
              {lot.district}, {lot.state} • {language === 'en' ? 'Moisture' : 'नमी'}: {lot.moisturePercent}% • {lot.farmerName}
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            onClick={onEditLot}
            className="px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors flex items-center gap-1.5"
          >
            <RotateCcw className="w-3.5 h-3.5" />
            <span>{language === 'en' ? 'Edit Lot Inputs' : 'विवरण बदलें'}</span>
          </button>

          <button
            onClick={onOpenAiAdvisor}
            className="px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors flex items-center gap-1.5 shadow-2xs"
          >
            <Sparkles className="w-3.5 h-3.5 text-emerald-600" />
            <span>{t.askAiCTA}</span>
          </button>
        </div>
      </div>

      {/* Primary Recommended Winning Card (PRD Core USP) */}
      <div id="primary-recommendation-winner" className="relative bg-gradient-to-br from-emerald-900 via-emerald-800 to-slate-900 text-white rounded-3xl p-6 sm:p-9 shadow-2xl border-2 border-emerald-400 overflow-hidden">
        {/* Visual Badge */}
        <div className="flex flex-wrap items-center justify-between gap-3 mb-6">
          <div className="inline-flex items-center gap-2 bg-emerald-400 text-slate-950 font-black text-xs sm:text-sm px-4 py-1.5 rounded-full uppercase tracking-wider shadow-md">
            <Sparkles className="w-4 h-4" />
            <span>{t.recBadge}</span>
          </div>

          <div className="flex items-center gap-2">
            <span className="text-xs text-emerald-200 font-medium">{t.scoreLabel}:</span>
            <span className="bg-emerald-500/30 text-emerald-300 font-black text-sm px-2.5 py-0.5 rounded-lg border border-emerald-400/40">
              {winningOption.recommendationScore} / 100
            </span>
          </div>
        </div>

        {/* Main Winning Title & Financial Realization */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div className="lg:col-span-7 space-y-3">
            <div className="flex items-center gap-2.5 text-emerald-300 text-sm font-semibold">
              {getOptionIcon(winningOption.optionId)}
              <span>{winningOption.subtitle}</span>
            </div>

            <h2 className="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
              {winningOption.title}
            </h2>

            {/* Nuanced Explanation Box */}
            <div className="bg-emerald-950/70 rounded-2xl p-4 border border-emerald-600/40 space-y-2 mt-4">
              <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-300">
                <ShieldCheck className="w-4 h-4 text-emerald-400" />
                <span>{t.whyRecommended}</span>
              </div>
              <p className="text-sm text-emerald-100 leading-relaxed">
                {isHindi ? recommendation.recommendationExplanation.hi : recommendation.recommendationExplanation.en}
              </p>
            </div>
          </div>

          {/* Right Side: Big Net Realization Box */}
          <div className="lg:col-span-5 bg-white text-slate-900 rounded-3xl p-6 shadow-xl border border-emerald-300 space-y-4">
            <div className="space-y-1 border-b border-slate-100 pb-3">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-500">
                {t.netRealizationHeader}
              </span>
              <div className="text-3xl sm:text-4xl font-black text-emerald-700 tracking-tight">
                ₹{winningOption.netRealization.toLocaleString('en-IN')}
              </div>
              <div className="text-xs font-bold text-slate-600 flex items-center justify-between pt-1">
                <span>{t.netPerQtl}:</span>
                <span className="font-mono text-sm font-black text-slate-900">₹{winningOption.netRealizationPerQtl} /qtl</span>
              </div>
            </div>

            {/* Quick Math Preview */}
            <div className="space-y-1.5 text-xs text-slate-600">
              <div className="flex justify-between">
                <span>{t.grossValue} (₹{winningOption.pricePerQtl}/qtl):</span>
                <span className="font-semibold text-slate-900">₹{winningOption.grossSaleValue.toLocaleString('en-IN')}</span>
              </div>
              <div className="flex justify-between text-rose-600">
                <span>{t.totalDeductions}:</span>
                <span className="font-semibold">-₹{winningOption.deductions.totalDeductions.toLocaleString('en-IN')}</span>
              </div>
              <div className="flex justify-between text-emerald-700 font-bold pt-1 border-t border-slate-100">
                <span>{language === 'en' ? 'Net Take-Home Margin:' : 'शुद्ध प्राप्ति दर:'}</span>
                <span>{winningOption.realizationPercent}% of Gross</span>
              </div>
            </div>

            {/* Advantage over Mandi Pill */}
            {recommendation.netAdvantageOverMandi > 0 && (
              <div className="bg-emerald-50 rounded-xl p-2.5 border border-emerald-200 text-xs font-bold text-emerald-800 flex items-center justify-between">
                <span>{t.advantageOverMandi}:</span>
                <span className="text-sm font-black text-emerald-700">+₹{recommendation.netAdvantageOverMandi.toLocaleString('en-IN')}</span>
              </div>
            )}

            {/* Primary Action Buttons */}
            <div className="space-y-2 pt-2">
              <button
                id="btn-accept-recommendation"
                onClick={handleAcceptWinning}
                className="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-md shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 hover:scale-102"
              >
                <span>{t.executeCTA}</span>
                <ArrowRight className="w-4 h-4" />
              </button>

              <button
                onClick={() => {
                  setSelectedBreakdownOption(winningOption);
                  setShowCostBreakdownModal(true);
                }}
                className="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs transition-colors flex items-center justify-center gap-1.5"
              >
                <FileText className="w-3.5 h-3.5 text-slate-500" />
                <span>{t.viewCostBreakdown}</span>
              </button>
            </div>
          </div>
        </div>

        {/* Key Benefits Ribbon */}
        <div className="mt-6 pt-6 border-t border-emerald-700/50 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs text-emerald-100">
          {winningOption.keyBenefits.map((benefit, idx) => (
            <div key={idx} className="flex items-center gap-2 bg-emerald-950/40 p-2.5 rounded-xl border border-emerald-700/30">
              <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
              <span className="font-medium leading-tight">{benefit}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Negotiation Panel */}
      {lot.farmerId && (
        <div className="mt-8 pt-6 border-t border-slate-200 space-y-4">
          <h3 className="text-lg font-bold text-slate-900">
            {language === 'en' ? 'Negotiate with Buyers' : 'खरीदारों के साथ बातचीत करें'}
          </h3>
          <p className="text-slate-500 mb-4">
            {language === 'en'
              ? 'Buyers can make offers on your produce. You can counter, accept, or reject offers.'
              : 'खरीदार आपके उत्पाद के लिए ऑफर लगा सकते हैं। आप counter-offर कर सकते हैं, स्वीकार कर सकते हैं, या拒绝 कर सकते हैं।'}
          </p>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              onClick={() => onInitiateNegotiation?.(lot, 'buyer-abc', 'ABC Agro Foods Ltd')}
              className="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-colors flex items-center justify-center gap-2"
            >
              <MessageCircle className="w-4 h-4" />
              {language === 'en' ? 'Make an Offer to Buyer' : 'खरीदार को ऑफर दें'}
            </button>
            <button
              disabled={!recommendation.recommendedOption.optionId === 'buyer'}
              className="w-full py-3 rounded-xl bg-slate-400 hover:bg-slate-500 text-slate-300 font-semibold text-sm shadow-xs transition-colors flex items-center justify-center gap-2"
            >
              <MessageSquare className="w-4 h-4" />
              {language === 'en' ? 'View Active Negotiations' : 'सक्रिय बातचीत देखें'}
            </button>
          </div>
          {/* Negotiation history would be loaded from backend */}
          <div id="negotiation-history" className="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
            <p className="text-slate-500 text-sm">Loading negotiation history...</p>
          </div>
        </div>
      )}

      {/* 4 Selling Options Cards Comparison Grid */}
      <div className="space-y-4">
        <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <h3 className="text-xl sm:text-2xl font-bold text-slate-900">
              {language === 'en' ? 'All 4 Evaluated Selling Options' : 'सभी 4 विकल्पों का तुलनात्मक ब्यौरा'}
            </h3>
            <p className="text-xs text-slate-500">
              {language === 'en'
                ? 'Sorted by Fasalniti Recommendation Score based on net realization, transport, storage, and counterparty reliability.'
                : 'शुद्ध प्राप्ति, भाड़ा, भंडारण और विश्वसनीयता के आधार पर क्रमबद्ध।'}
            </p>
          </div>

          <button
            onClick={onOpenComparison}
            className="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-bold border border-slate-300 shadow-xs flex items-center gap-1.5"
          >
            <span>{language === 'en' ? 'Open Full Matrix View' : 'विस्तृत तुलना मैट्रिक्स'}</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {recommendation.allOptions.map((opt, index) => {
            const isWinner = opt.optionId === winningOption.optionId;
            return (
              <div
                key={opt.optionId}
                className={`rounded-2xl p-5 bg-white border transition-all flex flex-col justify-between space-y-4 relative ${
                  isWinner
                    ? 'border-2 border-emerald-500 shadow-md ring-2 ring-emerald-500/10'
                    : 'border-slate-200 hover:border-slate-300 shadow-xs'
                }`}
              >
                {/* Header Rank Badge */}
                <div className="flex items-center justify-between">
                  <span className={`text-[11px] font-extrabold px-2 py-0.5 rounded-full ${
                    isWinner 
                      ? 'bg-emerald-600 text-white' 
                      : 'bg-slate-100 text-slate-700'
                  }`}>
                    #{index + 1} {opt.optionType}
                  </span>

                  <span className="text-xs font-bold text-slate-600">
                    Score: {opt.recommendationScore}/100
                  </span>
                </div>

                {/* Title */}
                <div>
                  <h4 className="font-bold text-sm text-slate-900 leading-snug line-clamp-2">
                    {opt.title}
                  </h4>
                  <p className="text-[11px] text-slate-500 mt-1 truncate">
                    {opt.subtitle}
                  </p>
                </div>

                {/* Financial Summary */}
                <div className="bg-slate-50 rounded-xl p-3 border border-slate-200/80 space-y-2">
                  <div>
                    <div className="text-[10px] uppercase font-bold text-slate-400">
                      {language === 'en' ? 'Net Take-Home' : 'शुद्ध प्राप्ति'}
                    </div>
                    <div className={`text-xl font-black ${isWinner ? 'text-emerald-700' : 'text-slate-900'}`}>
                      ₹{opt.netRealization.toLocaleString('en-IN')}
                    </div>
                    <div className="text-[11px] font-bold text-slate-500">
                      ₹{opt.netRealizationPerQtl} /qtl net
                    </div>
                  </div>

                  <div className="space-y-1 text-[11px] text-slate-600 border-t border-slate-200 pt-2">
                    <div className="flex justify-between">
                      <span>{language === 'en' ? 'Headline Rate:' : 'बोर्ड भाव:'}</span>
                      <span className="font-semibold text-slate-800">₹{opt.pricePerQtl}/qtl</span>
                    </div>
                    <div className="flex justify-between text-rose-600">
                      <span>{language === 'en' ? 'Total Deductions:' : 'कुल खर्चे:'}</span>
                      <span className="font-semibold">-₹{opt.deductions.totalDeductions.toLocaleString('en-IN')}</span>
                    </div>
                  </div>
                </div>

                {/* Benefits & Settlement Timeline */}
                <div className="space-y-2 text-xs">
                  <div className="text-[11px] text-slate-600 flex items-center gap-1">
                    <ShieldCheck className="w-3.5 h-3.5 text-slate-500" />
                    <span>{opt.paymentTimeline}</span>
                  </div>

                  <div className="pt-2 flex gap-2">
                    <button
                      onClick={() => onAcceptOption(opt)}
                      className={`flex-1 py-2 rounded-lg text-xs font-bold transition-colors ${
                        isWinner
                          ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs'
                          : 'bg-slate-800 hover:bg-slate-900 text-white'
                      }`}
                    >
                      {isWinner ? (language === 'en' ? 'Lock Winner' : 'सौदा पक्का करें') : (language === 'en' ? 'Select Option' : 'यह विकल्प चुनें')}
                    </button>

                    <button
                      onClick={() => {
                        setSelectedBreakdownOption(opt);
                        setShowCostBreakdownModal(true);
                      }}
                      className="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200"
                      title="View itemized breakdown"
                    >
                      <FileText className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Itemized Cost Breakdown Waterfall Modal */}
      {showCostBreakdownModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-6 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between border-b border-slate-100 pb-4">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">
                  {selectedBreakdownOption.optionType}
                </span>
                <h3 className="text-xl font-extrabold text-slate-900 mt-1">
                  {selectedBreakdownOption.title}
                </h3>
              </div>

              <button
                onClick={() => setShowCostBreakdownModal(false)}
                className="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm"
              >
                ✕
              </button>
            </div>

            {/* Waterfall Breakdown Rows */}
            <div className="space-y-3">
              <div className="bg-emerald-50/60 rounded-xl p-3.5 border border-emerald-200 flex justify-between items-center">
                <div>
                  <div className="font-bold text-sm text-emerald-950">{t.grossValue}</div>
                  <div className="text-xs text-emerald-700">{lot.quantityQuintals} qtl × ₹{selectedBreakdownOption.pricePerQtl}/qtl</div>
                </div>
                <div className="font-extrabold text-lg text-emerald-900">
                  ₹{selectedBreakdownOption.grossSaleValue.toLocaleString('en-IN')}
                </div>
              </div>

              <div className="space-y-2 text-xs text-slate-700 px-2">
                <div className="flex justify-between py-1.5 border-b border-slate-100">
                  <span className="flex items-center gap-1.5">
                    <Truck className="w-3.5 h-3.5 text-slate-500" />
                    <span>{language === 'en' ? 'Transportation Freight:' : 'परिवहन भाड़ा:'}</span>
                  </span>
                  <span className="font-bold text-rose-600">
                    -₹{selectedBreakdownOption.deductions.transportCost.toLocaleString('en-IN')}
                  </span>
                </div>

                <div className="flex justify-between py-1.5 border-b border-slate-100">
                  <span className="flex items-center gap-1.5">
                    <Warehouse className="w-3.5 h-3.5 text-slate-500" />
                    <span>{language === 'en' ? 'Storage & Silo Rent:' : 'भंडारण किराया:'}</span>
                  </span>
                  <span className="font-bold text-rose-600">
                    -₹{selectedBreakdownOption.deductions.storageCost.toLocaleString('en-IN')}
                  </span>
                </div>

                <div className="flex justify-between py-1.5 border-b border-slate-100">
                  <span className="flex items-center gap-1.5">
                    <Coins className="w-3.5 h-3.5 text-slate-500" />
                    <span>{language === 'en' ? 'Handling & Weighment (Hamali):' : 'पल्लेदारी व तुलाई खर्च:'}</span>
                  </span>
                  <span className="font-bold text-rose-600">
                    -₹{selectedBreakdownOption.deductions.handlingCost.toLocaleString('en-IN')}
                  </span>
                </div>

                <div className="flex justify-between py-1.5 border-b border-slate-100">
                  <span className="flex items-center gap-1.5">
                    <BadgePercent className="w-3.5 h-3.5 text-slate-500" />
                    <span>{language === 'en' ? 'Mandi Cess / Platform Tax:' : 'मंडी टैक्स / सेस:'}</span>
                  </span>
                  <span className="font-bold text-rose-600">
                    -₹{selectedBreakdownOption.deductions.mandiCessOrPlatformFee.toLocaleString('en-IN')}
                  </span>
                </div>

                <div className="flex justify-between py-1.5 border-b border-slate-100">
                  <span className="flex items-center gap-1.5">
                    <AlertCircle className="w-3.5 h-3.5 text-slate-500" />
                    <span>{language === 'en' ? 'Moisture & Quality Docking Risk:' : 'नमी कटौती व जोखिम:'}</span>
                  </span>
                  <span className="font-bold text-rose-600">
                    -₹{selectedBreakdownOption.deductions.qualityRiskAdjustment.toLocaleString('en-IN')}
                  </span>
                </div>
              </div>

              {/* Total Deductions Bar */}
              <div className="bg-rose-50 rounded-xl p-3 border border-rose-200 flex justify-between items-center text-xs">
                <span className="font-bold text-rose-900">{t.totalDeductions}:</span>
                <span className="font-extrabold text-sm text-rose-700">
                  -₹{selectedBreakdownOption.deductions.totalDeductions.toLocaleString('en-IN')}
                </span>
              </div>

              {/* Final Net Realization Bar */}
              <div className="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white rounded-2xl p-4 shadow-lg flex justify-between items-center">
                <div>
                  <div className="text-xs font-bold uppercase text-emerald-100">{t.netInBank}</div>
                  <div className="text-xs text-emerald-200 mt-0.5">{selectedBreakdownOption.paymentTimeline}</div>
                </div>
                <div className="text-right">
                  <div className="text-2xl font-black">
                    ₹{selectedBreakdownOption.netRealization.toLocaleString('en-IN')}
                  </div>
                  <div className="text-xs text-emerald-200 font-bold">
                    ₹{selectedBreakdownOption.netRealizationPerQtl} /qtl
                  </div>
                </div>
              </div>
            </div>

            {/* Modal Actions */}
            <div className="flex items-center gap-3 pt-2">
              <button
                onClick={() => {
                  setShowCostBreakdownModal(false);
                  onAcceptOption(selectedBreakdownOption);
                }}
                className="flex-1 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-colors"
              >
                {language === 'en' ? 'Accept this Breakdown' : 'यह विकल्प चुनें'}
              </button>

              <button
                onClick={() => setShowCostBreakdownModal(false)}
                className="px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition-colors"
              >
                {t.close}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
