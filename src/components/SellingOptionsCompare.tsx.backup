import React from 'react';
import { 
  Building, 
  TrendingUp, 
  Users, 
  Warehouse, 
  CheckCircle2, 
  XCircle, 
  ShieldCheck, 
  Truck, 
  Coins, 
  BadgePercent,
  ArrowRight,
  Sparkles
} from 'lucide-react';
import { RecommendationResult, SellingOptionBreakdown, Language, ProduceLot } from '../types';
import { translations } from '../utils/translations';

interface SellingOptionsCompareProps {
  language: Language;
  recommendation: RecommendationResult;
  lot: ProduceLot;
  onAcceptOption: (option: SellingOptionBreakdown) => void;
  onOpenAiAdvisor: () => void;
  onBack: () => void;
}

export const SellingOptionsCompare: React.FC<SellingOptionsCompareProps> = ({
  language,
  recommendation,
  lot,
  onAcceptOption,
  onOpenAiAdvisor,
  onBack,
}) => {
  const t = translations[language];

  return (
    <div className="max-w-6xl mx-auto px-4 py-6 space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200 shadow-xs">
        <div>
          <div className="flex items-center gap-2">
            <span className="text-xs font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded">
              {language === 'en' ? '4-Channel Matrix' : '4 माध्यमों की तुलना'}
            </span>
            <span className="text-xs text-slate-500 font-medium">
              {lot.crop} ({lot.quantityQuintals} qtl) • {lot.grade}
            </span>
          </div>
          <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
            {language === 'en' ? 'Side-by-Side Economic Comparison' : 'संपूर्ण वित्तीय एवं जोखिम तुलना'}
          </h2>
          <p className="text-xs text-slate-600 mt-1">
            {language === 'en'
              ? 'Compare headline prices against hidden freight, hamali, mandi cess, and counterparty payment risk.'
              : 'दिखने वाले भावों की छिपे हुए भाड़े, पल्लेदारी, मंडी टैक्स व भुगतान जोखिम के साथ तुलना।'}
          </p>
        </div>

        <div className="flex items-center gap-2.5">
          <button
            onClick={onOpenAiAdvisor}
            className="px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors flex items-center gap-1.5"
          >
            <Sparkles className="w-4 h-4 text-emerald-600" />
            <span>{t.askAiCTA}</span>
          </button>

          <button
            onClick={onBack}
            className="px-4 py-2 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors"
          >
            {t.back}
          </button>
        </div>
      </div>

      {/* Side by Side Comparison Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {recommendation.allOptions.map((opt) => {
          const isWinner = opt.optionId === recommendation.recommendedOption.optionId;

          return (
            <div
              key={opt.optionId}
              className={`bg-white rounded-3xl p-5 border transition-all flex flex-col justify-between space-y-5 ${
                isWinner
                  ? 'border-2 border-emerald-500 shadow-lg ring-2 ring-emerald-500/10'
                  : 'border-slate-200 shadow-xs hover:border-slate-300'
              }`}
            >
              {/* Option Head */}
              <div className="space-y-2">
                <div className="flex items-center justify-between">
                  <span className={`text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full ${
                    isWinner ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-700'
                  }`}>
                    {opt.optionType}
                  </span>
                  <span className="text-xs font-bold text-slate-600">
                    ★ {opt.recommendationScore}/100
                  </span>
                </div>

                <h3 className="font-extrabold text-base text-slate-900 leading-snug">
                  {opt.title}
                </h3>
                <p className="text-xs text-slate-500 truncate">
                  {opt.subtitle}
                </p>
              </div>

              {/* Economic Summary Highlight */}
              <div className={`p-4 rounded-2xl border space-y-2 ${
                isWinner ? 'bg-emerald-50/70 border-emerald-200' : 'bg-slate-50 border-slate-200'
              }`}>
                <div>
                  <div className="text-[10px] font-bold uppercase text-slate-400">
                    {language === 'en' ? 'Net Take-Home' : 'शुद्ध प्राप्ति'}
                  </div>
                  <div className={`text-2xl font-black ${isWinner ? 'text-emerald-700' : 'text-slate-900'}`}>
                    ₹{opt.netRealization.toLocaleString('en-IN')}
                  </div>
                  <div className="text-xs font-bold text-slate-600">
                    ₹{opt.netRealizationPerQtl} /qtl net
                  </div>
                </div>

                <div className="text-[11px] text-slate-600 border-t border-slate-200 pt-2 flex justify-between">
                  <span>{language === 'en' ? 'Gross (Headline):' : 'सकल भाव:'}</span>
                  <span className="font-bold text-slate-800">₹{opt.pricePerQtl}/qtl</span>
                </div>
              </div>

              {/* Deductions Breakdown Box */}
              <div className="space-y-2 text-xs text-slate-600">
                <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                  {language === 'en' ? 'Itemized Deductions:' : 'कटौतियों का ब्यौरा:'}
                </span>

                <div className="space-y-1.5 bg-slate-50/50 p-2.5 rounded-xl border border-slate-100">
                  <div className="flex justify-between">
                    <span className="text-slate-500">Freight Transport:</span>
                    <span className="font-semibold text-rose-600">-₹{opt.deductions.transportCost}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Hamali / Handling:</span>
                    <span className="font-semibold text-rose-600">-₹{opt.deductions.handlingCost}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Mandi Cess / Tax:</span>
                    <span className="font-semibold text-rose-600">-₹{opt.deductions.mandiCessOrPlatformFee}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Quality / Moisture:</span>
                    <span className="font-semibold text-rose-600">-₹{opt.deductions.qualityRiskAdjustment}</span>
                  </div>
                  <div className="flex justify-between font-bold text-rose-700 pt-1 border-t border-slate-200">
                    <span>Total Deductions:</span>
                    <span>-₹{opt.deductions.totalDeductions.toLocaleString('en-IN')}</span>
                  </div>
                </div>
              </div>

              {/* Trust & Timeline Specs */}
              <div className="space-y-2 text-xs">
                <div className="flex items-center justify-between text-slate-600">
                  <span>Reliability Index:</span>
                  <span className="font-bold text-slate-900">{opt.reliabilityScore}%</span>
                </div>
                <div className="flex items-center justify-between text-slate-600">
                  <span>Payment Speed:</span>
                  <span className="font-medium text-slate-800 truncate max-w-[130px]" title={opt.paymentTimeline}>
                    {opt.paymentTimeline}
                  </span>
                </div>
              </div>

              {/* Key Pros and Cons */}
              <div className="space-y-2 text-xs">
                <div className="space-y-1">
                  {opt.keyBenefits.slice(0, 2).map((benefit, i) => (
                    <div key={i} className="flex items-start gap-1.5 text-emerald-800">
                      <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                      <span className="text-[11px] font-medium leading-tight">{benefit}</span>
                    </div>
                  ))}
                </div>

                <div className="space-y-1 pt-1 border-t border-slate-100">
                  {opt.keyRisks.slice(0, 1).map((risk, i) => (
                    <div key={i} className="flex items-start gap-1.5 text-rose-700">
                      <XCircle className="w-3.5 h-3.5 text-rose-500 shrink-0 mt-0.5" />
                      <span className="text-[11px] leading-tight">{risk}</span>
                    </div>
                  ))}
                </div>
              </div>

              {/* Action Button */}
              <button
                onClick={() => onAcceptOption(opt)}
                className={`w-full py-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${
                  isWinner
                    ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/25'
                    : 'bg-slate-800 hover:bg-slate-900 text-white'
                }`}
              >
                <span>{isWinner ? (language === 'en' ? 'Lock Best Option' : 'सर्वोत्तम विकल्प चुनें') : (language === 'en' ? 'Choose This Option' : 'यह विकल्प चुनें')}</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </button>
            </div>
          );
        })}
      </div>
    </div>
  );
};
