import React, { useState } from 'react';
import { ArrowRight } from 'lucide-react';
import { Language } from '../types';
import { translations } from '../utils/translations';

interface LandingHeroProps {
  language: Language;
  onStartAnalysis: (crop?: string, quantityQtl?: number) => void;
  onNavigateToBuyer: () => void;
  onNavigateToAggregation: () => void;
  onOpenAiAdvisor: () => void;
}

export const LandingHero: React.FC<LandingHeroProps> = ({
  language,
  onStartAnalysis,
  onNavigateToBuyer,
  onNavigateToAggregation,
  onOpenAiAdvisor,
}) => {
  const t = translations[language];

  return (
    <div className="space-y-16 py-6 sm:py-10">
      <div className="text-center max-w-4xl mx-auto px-4">
        <div className="flex flex-wrap items-center justify-center gap-2">
          <div className="inline-flex items-center gap-2 px-3 py-2 rounded-md bg-emerald-50 text-emerald-800 text-xs sm:text-sm font-medium">
            <span className="w-3 h-3 text-emerald-600">•</span>
            <span>{language === 'en' ? 'Decision Intelligence Layer for Agriculture' : 'Agriculture Decision Platform'}</span>
          </div>
        </div>

        <h1 className="text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-900">
          Get Started with Your Crop
        </h1>

        <p className="text-lg sm:text-xl text-slate-600">
          {t.uspSubheading}
        </p>

        <div className="flex flex-wrap items-center justify-center gap-3.5 pt-2">
          <button
            onClick={() => onStartAnalysis('Wheat', 45)}
            className="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base shadow-lg shadow-emerald-600/25 hover:shadow-emerald-600/35 transition-all flex items-center gap-2 hover:scale-102 cursor-pointer"
          >
            <span>{t.findOptionCTA}</span>
            <ArrowRight className="w-4 h-4" />
          </button>

          <button
            onClick={onNavigateToAggregation}
            className="px-4 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-sm sm:text-base transition-all flex items-center gap-2 cursor-pointer"
          >
            <span>{language === 'en' ? 'Farmer Pooling' : 'Farmer Pooling'}</span>
          </button>

          <button
            onClick={onNavigateToBuyer}
            className="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-base border border-slate-300 shadow-xs transition-all flex items-center gap-2 cursor-pointer"
          >
            <span>{t.imBuyerCTA}</span>
          </button>
        </div>
      </div>
    </div>
  );
}
