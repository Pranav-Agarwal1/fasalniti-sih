# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOVERNMENT_DATA_API_KEY: Optional API key for Government of India Open Government Data Platform (data.gov.in).
# If unavailable, the system will use calculated estimates and mock data as fallback.
# Get your key from: https://data.gov.in/
GOVERNMENT_DATA_API_KEY="MY_GOV_DATA_API_KEY"

# GOVERNMENT_DATA_ENABLED: Set to "true" to enable government data fetching, "false" to use calculated/mock data only.
# Default: "false" (recommended for production without confirmed API access)
GOVERNMENT_DATA_ENABLED="false"
